# Which backend the agents call: groq | bedrock
# groq    = fast, free, the local default for building and for the demo
# bedrock = Claude on AWS, billed against the hackathon sandbox lease
LLM_PROVIDER=groq

# Groq (training: sign up for a free Groq account)
GROQ_API_KEY=
GROQ_MODEL=openai/gpt-oss-120b
# Lighter agents use this; splits load across two per-model rate-limit pools
GROQ_FAST_MODEL=openai/gpt-oss-20b

# Claude Agent SDK specialist (optional)
ANTHROPIC_API_KEY=

# AWS Bedrock  (set LLM_PROVIDER=bedrock to actually use these)
#
# Region is where BEDROCK runs, NOT the SSO region from the access portal.
# The portal signs you in at ap-southeast-1; Bedrock inference is us-east-1.
# Using the portal's region gives a wall of "Access denied to bedrock:*".
AWS_REGION=us-east-1
#
# Sandbox credentials come from AWS access portal -> Accounts -> expand your
# account -> "Access keys" -> Option 1. They are TEMPORARY: all three values
# are required, and they EXPIRE EVERY 12 HOURS. Re-copy them before a session.
AWS_ACCESS_KEY_ID=
AWS_SECRET_ACCESS_KEY=
AWS_SESSION_TOKEN=
#
# Haiku by default: the lease is capped at US$20 and access is revoked there,
# so the cheapest capable model is the right default. Bedrock ids are prefixed
# `anthropic.`.
BEDROCK_MODEL_ID=anthropic.claude-haiku-4-5
#
# AgentCore Memory is NOT implemented (harness/agentcore.py put_memory is a
# no-op). Leave blank; setting it does not turn anything on.
BEDROCK_AGENTCORE_MEMORY_ID=

# OpenTelemetry
OTEL_SERVICE_NAME=creatorloop
OTEL_EXPORTER_OTLP_ENDPOINT=

# MCP
MCP_URL=http://localhost:8085

# AG-UI
AGUI_URL=http://localhost:8084/ag-ui

# Where the AG-UI event stream lives (Vite UI client).
#
# Day 1-4 (fixtures):  the UI server on :8000 replays demo/fixtures/*.jsonl
# Day 5 (live):        point straight at P2's CDR agent
#
VITE_AGUI_URL=/ag-ui
# VITE_AGUI_URL=http://localhost:8084/ag-ui

# Feature flags
USE_FIXTURES=1
PAUSE_BEFORE_SEND=0

# Service URLs (local defaults)
OPPORTUNITY_FINDER_URL=http://localhost:8081
PIPELINE_MANAGER_URL=http://localhost:8082
ENGAGEMENT_LISTENER_URL=http://localhost:8083
CDR_URL=http://localhost:8084
UI_URL=http://localhost:8000

# Optional live tools
TAVILY_API_KEY=
GOOGLE_MAPS_API_KEY=
SMTP_HOST=
SMTP_USER=
SMTP_PASSWORD=
FROM_EMAIL=maya@creatorloop.local
